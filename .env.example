# Copie para .env.local e preencha quando a integração com o Supabase for ativada.
# Nunca coloque chaves privadas em variáveis NEXT_PUBLIC_* — elas vão para o navegador.

# Fonte de dados: com o Supabase configurado usa os dados reais.
# Defina "demo" para forçar os dados demonstrativos.
# MEUMIX_DATA_SOURCE=demo

# Supabase (públicas — protegidas por Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_... (ou NEXT_PUBLIC_SUPABASE_ANON_KEY)

# Supabase (privada — somente no servidor)
SUPABASE_SECRET_KEY=   # sb_secret_... (ou SUPABASE_SERVICE_ROLE_KEY)

# Steam Web API (opcional, privada — somente no servidor). Sem ela, a foto vem do perfil público.
STEAM_WEB_API_KEY=

# Super administradores (e-mails separados por vírgula). Somente servidor.
# Podem criar mixes e nomear/remover administradores. Exige e-mail confirmado.
SUPER_ADMIN_EMAILS=diogoarauujo@gmail.com

# Apenas desenvolvimento local: simula uma sessão para visualizar telas restritas.
# Ignorado em produção.
# MEUMIX_DEV_SESSION_EMAIL=diogoarauujo@gmail.com

# Leitura dos prints da Gamers Club por IA (somente servidor).
# Gemini (tem cota gratuita): crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: GPT da OpenAI (pago). Se definido, é usado primeiro e o Gemini vira o alternativo.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_FALLBACK_MODEL=gpt-4o-mini
# Opcionais: modelo principal e alternativo (usado na hora em caso de sobrecarga).
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
